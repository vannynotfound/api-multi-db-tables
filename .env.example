# Server
PORT=3000

# MySQL database (these are the values the DatabaseService reads)
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# JWT
JWT_ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
JWT_REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_EXPIRES_IN=900s
REFRESH_TOKEN_EXPIRES_IN=7d
